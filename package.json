{
  "name": "@stocket/packages-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "publish:prepare": "pnpm --filter @stocket/types barrels && pnpm build",
    "release": "pnpm publish:prepare && changeset publish",
    "version:packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "typescript": "catalog:"
  }
}
